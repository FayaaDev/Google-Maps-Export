GOOGLE_MAPS_API_KEY=YOUR_API_KEY
# Comma-separated keywords, searched one by one. Repeated places appear only once.
SEARCH_KEYWORDS=coffee shops,bakeries

# Edit boundary.txt: one latitude,longitude pair per line, in border order.
SEARCH_POLYGON_FILE=boundary.txt



GRID_SIZE=3
MAX_DEPTH=2
# Optional: otherwise keywords + a timestamp are used. Existing files are never overwritten.
# OUTPUT_CSV=my-results.csv
